{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Backend (FastAPI)",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m uvicorn main:app --reload --host 127.0.0.1 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "solvane",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Frontend (Vite React)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "solvane",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start Solvane (Both Servers)",
      "dependsOn": [
        "Run Backend (FastAPI)",
        "Run Frontend (Vite React)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
